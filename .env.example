# Server Configuration
PORT=4001
NODE_ENV=development
JWT_SECRET=super-secret-yol-malumoti-development-key-change-in-production
JWT_REFRESH_SECRET=super-refresh-secret-yol-malumoti-change-in-production

# Client Configuration
VITE_API_URL=http://localhost:4001/api/v1

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://yol_user:yol_password@localhost:5432/yol_malumoti
REDIS_URL=redis://localhost:6379

# Storage Configuration (MinIO / S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yol-reports

# External API Settings
NOMINATIM_USER_AGENT=YolMalumotiUzbekistan/1.0

# Emergency Dispatch Module Configuration (103, 102, 101, 104, 1050)
AMBULANCE_ACCEPT_TIMEOUT_SECONDS=60
AMBULANCE_QUEUE_PENALTY_SECONDS=720
SIMULATE_AMBULANCES=true
AMBULANCE_SIM_SPEEDUP=8
AMBULANCE_RETENTION_DAYS=30
