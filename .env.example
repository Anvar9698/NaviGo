# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super-secret-yol-malumoti-development-key-change-in-production
JWT_REFRESH_SECRET=super-refresh-secret-yol-malumoti-change-in-production

# Client Configuration
VITE_API_URL=http://localhost:4000/api/v1

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://yol_user:yol_password@localhost:5432/yol_malumoti
REDIS_URL=redis://localhost:6379

# Storage Configuration (MinIO / S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yol-reports

# External API Settings
NOMINATIM_USER_AGENT=YolMalumotiUzbekistan/1.0
